# .env.koyeb - Variáveis de Ambiente para Koyeb
# Use essas valores ao configurar as Environment Variables no Dashboard do Koyeb

APP_NAME="Loop Lab"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://loop-lab.koyeb.app

# Gere uma nova chave com: php artisan key:generate --show
APP_KEY=base64:MqKX3eCFKp7d8Y9mN2zK4sB5jL8qR3wT9uV2xC6pD7f=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Database (SQLite)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=info

# Sessions (importante para manter estado de usuário)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Cache
CACHE_STORE=database

# Queue (para jobs assincronos se necessário)
QUEUE_CONNECTION=database

# Broadcasting
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Mail (opcional - por enquanto usando log)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@loop-lab.koyeb.app
MAIL_FROM_NAME="Loop Lab"
